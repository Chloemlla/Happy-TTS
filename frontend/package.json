{
  "name": "synapse-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.scss",
    "*.sass",
    "*.less"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:simple": "tsc && vite build --mode simple",
    "build:minimal": "tsc && vite build --mode minimal",
    "build:analyze": "tsc && vite build --mode analyze",
    "build:optimized": "tsc && vite build --mode production",
    "preview": "vite preview",
    "test:rate-limit": "node test-rate-limit.js",
    "security-check": "node security-check.js",
    "test": "vitest",
    "analyze": "npm run build:analyze && npx vite-bundle-analyzer dist",
    "analyze:bundle": "node scripts/analyze-bundle.js",
    "fix:rollup": "node fix-rollup-deps.js",
    "fix:rollup:win": "node fix-rollup-win.js",
    "fix:rollup:smart": "chmod +x fix-rollup-deps.sh && ./fix-rollup-deps.sh"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@heroicons/react": "^2.2.0",
    "@microsoft/clarity": "^1.0.2",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@react-email/components": "1.0.12",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jsdom": "^28.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/validator": "^13.15.10",
    "axios": "^1.16.1",
    "bcrypt": "^6.0.0",
    "buffer": "^6.0.3",
    "canvg": "^4.0.3",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.3.0",
    "docx": "^9.6.1",
    "dompurify": "^3.4.5",
    "express-rate-limit": "^8.5.2",
    "form-data": "^4.0.5",
    "framer-motion": "^12.40.0",
    "highlight.js": "^11.11.1",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.3",
    "javascript-obfuscator": "^5.4.3",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "katex": "^0.17.0",
    "lodash.merge": "^4.6.2",
    "lucide-react": "^1.16.0",
    "marked": "^18.0.4",
    "marked-highlight": "^2.2.4",
    "marked-katex-extension": "^5.1.9",
    "md5": "^2.3.0",
    "mermaid": "^11.15.0",
    "prismjs": "^1.30.0",
    "process": "^0.11.10",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-chartjs-2": "^5.3.1",
    "react-copy-to-clipboard": "^5.1.1",
    "react-debounce-input": "^3.3.0",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "react-inspector": "^9.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.1",
    "react-syntax-highlighter": "^16.1.1",
    "react-toastify": "^11.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "rollup": "^4.60.4",
    "swagger-ui-react": "^5.32.6",
    "tailwind-merge": "^3.6.0",
    "util": "^0.12.5",
    "validator": "^13.15.35",
    "vite-plugin-auto-i18n": "^0.0.9"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.0.7",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/javascript-obfuscator": "^0.17.0",
    "@types/jest": "^30.0.0",
    "@types/marked": "^6.0.0",
    "@types/md5": "^2.3.6",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/ui": "^4.1.7",
    "autoprefixer": "^10.5.0",
    "cross-env": "^10.1.0",
    "javascript-obfuscator": "^5.4.1",
    "jest-environment-jsdom": "^30.4.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "react-email": "6.3.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.3.0",
    "terser": "^5.48.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vite-auto-i18n-plugin": "^1.1.16",
    "vite-plugin-obfuscator": "^1.0.5",
    "vitest": "^4.1.7"
  },
  "pnpm": {
    "overrides": {
      "marked": "$marked",
      "react": "$react",
      "react-dom": "$react-dom",
      "lodash-es": ">=4.18.1",
      "minimatch": ">=10.2.1",
      "dompurify": "$dompurify",
      "lodash": ">=4.18.0"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "19",
        "react-dom": "19",
        "marked": "17"
      }
    }
  }
}
