# ============================================
# Synapse 环境变量配置示例
# 复制此文件为 .env 并按需修改
# ============================================

# === 运行环境 ===
NODE_ENV=development
PORT=3000

# === MongoDB（必需） ===
MONGO_URI=mongodb://localhost:27017/tts
# MONGODB_URI=                    # MONGO_URI 的别名，二选一
MONGO_DB=tts
# 存储模式：仅支持 mongo（CLAUDE.md 约束）
USER_STORAGE_MODE=mongo
# 生产 Mongo 代理地址（docker-compose 会透传；可选）
# MONGO_PROXY_URL=

# === Redis（可选，用于缓存和 IP 封禁） ===
# REDIS_URL=redis://localhost:6379

# === JWT 认证 ===
# 生产环境必须设置，否则启动时使用临时密钥（重启后所有会话失效）
JWT_SECRET=your-jwt-secret-here
# JWT_EXPIRES_IN=30d

# === 管理员 ===
ADMIN_USERNAME=admin
# 生产环境必须设置
ADMIN_PASSWORD=your-admin-password-here
# ADMIN_OPERATION_PASSWORD=      # 操作密码，未设置时使用 ADMIN_PASSWORD

# === OpenAI TTS ===
# 生产环境必须设置
OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_KEY=                    # 别名，二选一
# 生产环境必须设置（TTS 服务必需；自定义代理/中转时改为对应地址）
OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=tts-1
# OPENAI_VOICE=alloy
# OPENAI_RESPONSE_FORMAT=mp3
# OPENAI_SPEED=1.0

# === 其他 TTS 提供商 ===
# TTS_PROVIDER=
# FISH_AUDIO_API_KEY=
# FISH_AUDIO_BASE_URL=

# === 安全 ===
# WAF_ENABLED=true               # 默认 true；生产不建议关闭
# Cloudflare Turnstile（前端验证开启时需要；生产建议设置）
# TURNSTILE_SECRET_KEY=your-turnstile-secret
# TURNSTILE_SITE_KEY=your-turnstile-site-key
# ENABLE_FIRST_VISIT_VERIFICATION=true   # 首访验证闸门的启动默认值；运行期在 env-manager「首访验证闸门」分区改（保存即生效）
# 敏感字段加密密钥（生产建议设置；AES）
# AES_KEY=your-32-byte-aes-key
# 签名私钥文件路径（默认 secrets/signing_key.pem）
# OIDC id_token 签名密钥：该文件存在时从这里读取；文件缺失时自动生成一把新的
# RSA-2048 密钥并持久化到 MongoDB（collection: oidc_signing_keys），重启后继续复用。
# SIGNING_KEY=secrets/signing_key.pem
# SIGN_SECRET_KEY=

# === 前端 ===
# VITE_API_URL=https://chloemlla.com
# VITE_VERCEL_ANALYTICS=true   # 强制开启 Vercel Web Analytics（vercel 模式构建已默认开启，自建默认关闭）
# FRONTEND_URL=https://chloemlla.com
# BASE_URL=

# === 邮箱 ===
# 生产环境必填（注册验证 / 密码重置邮件）
# RESEND_API_KEY=re_your-resend-api-key
# RESEND_DOMAIN=chloemlla.com

# === IPFS / 图床 ===
# IPFS_UPLOAD_URL=
# IPFS_UA=
# IMAGE_BED_API_URL=https://img.scdn.io/api/v1.php
# IMAGE_BED_STORAGE_DESTINATION=

# === Linux Do 积分 ===
# LINUXDO_CREDIT_ENABLED=false
# LINUXDO_CREDIT_PID=
# LINUXDO_CREDIT_KEY=
# LINUXDO_CREDIT_PROTOCOL=epay
# LINUXDO_CREDIT_GATEWAY_BASE=
# LINUXDO_CREDIT_PRIVATE_KEY=
# LINUXDO_CREDIT_NOTIFY_URL=
# LINUXDO_CREDIT_RETURN_URL=

# === Google / NexAI 认证 ===
# GOOGLE_CLIENT_ID=
# NEXAI_GOOGLE_CLIENT_ID=
# NEXAI_GITHUB_CLIENT_ID=
# NEXAI_GITHUB_CLIENT_SECRET=
# NEXAI_FRONTEND_URL=
# NEXAI_APP_SIGN_SECRET=

# === CDict 官方客户端请求签名 ===
# CDICT_REQUEST_SIGNING=soft
# CDICT_APP_SIGN_SECRET=
# CDICT_APP_SIGN_SECRET_PREV=
# CDICT_SIG_MAX_DRIFT_MS=300000
# 生产环境需要 REDIS_URL 才会授予官方客户端独立额度；缺失时安全降级到普通 IP 限流。

# === WebAuthn ===
# 生产环境必须设置（Passkey/WebAuthn 的域名与来源）
# RP_ID=chloemlla.com
# RP_ORIGIN=https://chloemlla.com

# === 其他 ===
# AUDIT_LOG_MASKING=true
# SERVER_PASSWORD=
# GENERATION_CODE=
# PUBLIC_SHORT_URL_ENABLED=false
# PUBLIC_SHORT_URL_PASSWORD=
# INTERNAL_SERVICE_TOKEN=

# === Project Lumen GitHub Secret Sync ===
# 用于将 Project Lumen 配置推送至 GitHub 仓库的 Actions secrets。
# Token 需要具备目标仓库 Actions secrets 写入权限（classic token 需 repo 权限，或 fine-grained token 需 Secrets: write）。
# PROJECT_LUMEN_GITHUB_OWNER=Chloemlla
# PROJECT_LUMEN_GITHUB_REPO=Project-Lumen
# PROJECT_LUMEN_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# === CDict 客户端代理（/api/cdict/*）===
# CDict Android 客户端不再直连上游，统一请求本服务；以下变量留空时使用内置默认值。
# VIVO_TRANSLATE_BASE_URL=https://vivotrans.vivo.com
# VIVO_TRANSLATE_APP_ID=
# VIVO_TTS_URL=https://vivotrans.vivo.com.cn/fy/tts
# VIVO_TTS_APP_ID=
# VIVO_TTS_APP_KEY=

# === 语音转文本 / 媒体工具（media-tool）===
# 用户入口在 /transcribe（核心功能），管理端在 /admin/media-tool。
# 这里只留「换一台机器就得改」的几项：总开关、落盘目录、服务地址与凭据。
# 其余参数（语种、场景、默认产物、并发、重试、续传、上传上限、用户页限额）写死在
# src/mediaTool/types.ts；要微调请走「管理后台 → 媒体工具 → 设置」（存数据库，会覆盖代码默认值）。
# 显式写了值的环境变量是最终权威：它会盖掉设置页里存在库里的同名项。
# 也可以在「管理后台 → 系统配置 → 语音转文本与媒体工具」在线改这几项。
# MEDIA_TOOL_DISABLED=1              # 停用整个媒体工具（含用户页转写）
# MEDIA_TOOL_WORK_DIR=               # 工作根目录，留空=进程目录下 data/media-tool
# --- 转写服务（留空即用内置默认值）---
# MEDIA_TOOL_LASR_URL=
# MEDIA_TOOL_APP_ID=
# MEDIA_TOOL_APP_KEY=                # 请求签名密钥
# --- 账号凭据（可选，留空走未登录路径）---
# MEDIA_TOOL_VIVO_TOKEN=
# MEDIA_TOOL_VIVO_OPENID=
# --- B 站下载（yt-dlp）路径 ---
# MEDIA_TOOL_YTDLP=                  # 留空自动探测 PATH
# MEDIA_TOOL_COOKIES=                # Netscape cookies 文件路径
# MEDIA_TOOL_DOWNLOAD_DIR=           # 留空=与 WORK_DIR 相同
# MEDIA_TOOL_YTDLP_USER_AGENT=       # 下载 B 站时的 UA，留空=内置桌面 Chrome UA（B 站对非浏览器请求返回 412）
